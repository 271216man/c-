#include <stdio.h>
#include <stdlib.h>
#define MAX 1000005
#define MAXN 10000005
int a[MAX], cnt[MAXN],n,k = 0;
void counting_sort()
{
    int i, max;
    max = a[0];
    for (i = 1; i < n; i++)
    {
        if (a[i] > max)
            max = a[i];
    }
    for (i = 0; i <= max; i++)
    {
        cnt[i] = 0;
    }
    for (i = 0; i < n; i++)
    {
        cnt[a[i]]++;
    }
    for (i = 0; i <= max; i++)
    {
        while(cnt[i] > 0)
        {
            a[k++] = i;
            cnt[i]--;
        }
    }
}
int main()
{
    int i = 0;
    if(scanf("%d",&n)!=1) return 0;
    for(i=0;i<n;i++)
    {
        if(scanf("%d",&a[i])!=1) return 0;
    }
    counting_sort();
    for (i = 0; i < n; i++)
    {
        if (i > 0)
            printf(" ");
        printf("%d", a[i]);
    }
    printf("\n");
    return 0;
}
